# ---- Dependencies ----
node_modules/
.pnp
.pnp.js

# ---- Environment variables / secrets ----
# Never commit real env files — Mongo URI, JWT secret, etc. live here
.env
.env.*
!.env.example

# ---- Logs ----
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# morgan / custom log output, if you write request logs to disk
access.log
combined.log
error.log

# ---- Runtime / process managers ----
pids/
*.pid
*.seed
*.pid.lock

# ---- Coverage / test output ----
coverage/
.nyc_output/

# ---- Build output (if you ever add a build step, e.g. babel/tsc) ----
dist/
build/

# ---- Uploaded / generated files (adjust path if you store uploads elsewhere) ----
uploads/
tmp/

# ---- OS files ----
.DS_Store
Thumbs.db

# ---- Editor / IDE ----
.vscode/
.idea/
*.swp

# ---- Package manager lockfile noise (keep ONE lockfile in your repo, ignore the rest) ----
# Uncomment whichever lockfiles you are NOT using:
# yarn.lock
# pnpm-lock.yaml

# ---- Misc ----
*.local

desktop.ini